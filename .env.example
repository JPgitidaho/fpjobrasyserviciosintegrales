# Proveedor de correo (Resend). Configurar en Vercel > Settings > Environment Variables.
RESEND_API_KEY=
# Debe pertenecer a un dominio verificado en el proveedor, p. ej. "FPJ Cotizaciones <cotizaciones@obrasyserviciosintegralesfpj.cl>"
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=obrasyserviciosintegralesfpj@gmail.com
# Opcional: orígenes extra permitidos, separados por comas
ALLOWED_ORIGINS=
